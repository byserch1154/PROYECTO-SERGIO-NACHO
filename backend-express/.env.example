# Copia este fichero como .env y pon tus datos (el .env NO se sube a Git)
PORT=3000

# Conexión a PostgreSQL (base creada con 01_esquema.sql + 02_datos.sql + 07_web_backend.sql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=SPEAKE
PGUSER=postgres
PGPASSWORD=cambia_esto

# Carpetas (rutas relativas a backend-express/)
WEB_DIR=../lenguaje-de-marcas
LOG_DIR=./logs
EXPORT_DIR=./data/export
USUARIOS_JSON=./data/usuarios_sneaker.json

# Minutos que dura una sesión del panel de gestión
SESION_MINUTOS=120

# Integración con Odoo (opcional). Si se deja vacío, no se envía nada a Odoo.
# Al confirmar un pedido en el panel se crea su pedido de venta en Odoo por la API.
# ODOO_PASSWORD: mejor una clave API (Odoo > Mi perfil > Seguridad de la cuenta > Nueva clave API)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=
# 1 = confirmar también el pedido en Odoo (genera la fabricación MTO); 0 = dejarlo en presupuesto
ODOO_CONFIRMAR=1

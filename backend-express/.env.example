# Copia este fichero como .env y pon tus datos (el .env NO se sube a Git)
PORT=3000

# Conexión a PostgreSQL (base creada con 01_esquema.sql + 02_datos.sql + 07_web_backend.sql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=sneaker_factory
PGUSER=postgres
PGPASSWORD=cambia_esto

# Carpetas (rutas relativas a backend-express/)
WEB_DIR=../lenguaje-de-marcas
LOG_DIR=./logs
EXPORT_DIR=./data/export
USUARIOS_JSON=./data/usuarios_sneaker.json

# Minutos que dura una sesión del panel de gestión
SESION_MINUTOS=120

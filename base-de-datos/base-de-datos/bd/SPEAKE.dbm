<function name="fn_login"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="sql"/>
	<return-type>
	<type name="integer" length="0"/>
	</return-type>
	<parameter name="p_username">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_password">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[    SELECT id_usuario FROM usuarios
     WHERE username = p_username AND activo
       AND password_hash = crypt(p_password, password_hash);]]></definition>
</function>

<function name="fn_usuario_actual"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="integer" length="0"/>
	</return-type>
	<definition><![CDATA[DECLARE
    v text := current_setting('app.id_usuario', true);
    u integer;
BEGIN
    IF v IS NULL OR v = '' THEN
        RAISE EXCEPTION 'Operación sin usuario autenticado'
              USING ERRCODE = '28000';
    END IF;
    SELECT id_usuario INTO u FROM usuarios WHERE id_usuario = v::integer AND activo;
    IF u IS NULL THEN
        RAISE EXCEPTION 'Usuario % inexistente o inactivo', v
              USING ERRCODE = '28000';
    END IF;
    RETURN u;
END ]]></definition>
</function>

<function name="fn_tiene_permiso"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="sql"/>
	<return-type>
	<type name="boolean" length="0"/>
	</return-type>
	<parameter name="p_operacion">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[    SELECT coalesce((SELECT p.permitido
                       FROM usuarios u JOIN permisos p ON p.id_rol = u.id_rol
                      WHERE u.id_usuario = fn_usuario_actual()
                        AND p.operacion = p_operacion), false);]]></definition>
</function>

<function name="fn_exigir_permiso"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="void" length="0"/>
	</return-type>
	<parameter name="p_operacion">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    IF NOT fn_tiene_permiso(p_operacion) THEN
        RAISE EXCEPTION 'Permiso denegado: su rol no puede ejecutar "%"', p_operacion
              USING ERRCODE = '42501';
    END IF;
END ]]></definition>
</function>

<function name="fn_pedidos_permisos"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[BEGIN
    IF TG_OP = 'INSERT' THEN
        PERFORM fn_exigir_permiso('crear_pedido');
        -- Un pedido nuevo siempre nace pendiente: confirmarlo es una transición
        -- (UPDATE) que descuenta stock. Si pudiera nacer confirmado se saltaría el stock.
        IF NEW.estado <> 'pendiente' THEN
            RAISE EXCEPTION 'Un pedido nuevo debe crearse como pendiente (recibido: %)', NEW.estado;
        END IF;
        NEW.creado_por := fn_usuario_actual();
        RETURN NEW;
    ELSIF TG_OP = 'UPDATE' THEN
        IF OLD.estado IS DISTINCT FROM NEW.estado THEN
            PERFORM fn_exigir_permiso(CASE NEW.estado
                WHEN 'confirmado' THEN 'confirmar_pedido'
                WHEN 'cancelado'  THEN 'cancelar_pedido'
                WHEN 'entregado'  THEN 'entregar_pedido'
                ELSE 'editar_pedido' END);
        ELSIF OLD.id_cliente IS DISTINCT FROM NEW.id_cliente
           OR OLD.fecha      IS DISTINCT FROM NEW.fecha THEN
            PERFORM fn_exigir_permiso('editar_pedido');
        END IF;   -- cambios de total/tipo son derivados (los hace otro trigger)
        RETURN NEW;
    ELSE
        PERFORM fn_exigir_permiso('eliminar_pedido');
        RETURN OLD;
    END IF;
END ]]></definition>
</function>

<trigger name="t1_pedidos_permisos" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="true" upd-event="true" trunc-event="false"
	 table="public.pedidos">
		<function signature="public.fn_pedidos_permisos()"/>
</trigger>

<function name="fn_pedidos_validar"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[BEGIN
    IF TG_OP = 'DELETE' THEN
        IF OLD.estado <> 'pendiente' THEN
            RAISE EXCEPTION 'Solo se pueden eliminar pedidos pendientes (%: %)', OLD.referencia, OLD.estado;
        END IF;
        RETURN OLD;
    END IF;

    IF NEW.estado IS DISTINCT FROM OLD.estado THEN
        IF NOT ((OLD.estado = 'pendiente'  AND NEW.estado IN ('confirmado','cancelado'))
             OR (OLD.estado = 'confirmado' AND NEW.estado IN ('entregado','cancelado'))) THEN
            RAISE EXCEPTION 'Transición no permitida en %: % -> %', OLD.referencia, OLD.estado, NEW.estado;
        END IF;
        IF NEW.estado = 'confirmado'
           AND NOT EXISTS (SELECT 1 FROM lineas_pedido WHERE id_pedido = NEW.id_pedido) THEN
            RAISE EXCEPTION 'No se puede confirmar % sin líneas', OLD.referencia;
        END IF;
    ELSIF OLD.estado <> 'pendiente'
          AND (OLD.id_cliente IS DISTINCT FROM NEW.id_cliente
            OR OLD.fecha      IS DISTINCT FROM NEW.fecha) THEN
        RAISE EXCEPTION 'El pedido % está % y ya no es editable', OLD.referencia, OLD.estado;
    END IF;
    RETURN NEW;
END ]]></definition>
</function>

<trigger name="t2_pedidos_validar" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="false" del-event="true" upd-event="true" trunc-event="false"
	 table="public.pedidos">
		<function signature="public.fn_pedidos_validar()"/>
</trigger>

<function name="fn_pedidos_stock"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[DECLARE
    r record;
BEGIN
    IF OLD.estado = 'pendiente' AND NEW.estado = 'confirmado' THEN
        FOR r IN SELECT l.id_modelo, l.talla, sum(l.cantidad)::integer AS q, m.nombre
                   FROM lineas_pedido l JOIN modelos m USING (id_modelo)
                  WHERE l.id_pedido = NEW.id_pedido
                  GROUP BY l.id_modelo, l.talla, m.nombre
                  ORDER BY l.id_modelo, l.talla            -- orden fijo: evita interbloqueos
        LOOP
            UPDATE stock
               SET stock_disponible = stock_disponible - r.q, fecha_corte = now()
             WHERE id_modelo = r.id_modelo AND talla = r.talla
               AND stock_disponible >= r.q;
            IF NOT FOUND THEN
                RAISE EXCEPTION 'Stock insuficiente para % talla % (se piden % pares)',
                      r.nombre, r.talla, r.q USING ERRCODE = '23514';
            END IF;
        END LOOP;
    ELSIF OLD.estado = 'confirmado' AND NEW.estado = 'cancelado' THEN
        UPDATE stock s
           SET stock_disponible = s.stock_disponible + x.q, fecha_corte = now()
          FROM (SELECT id_modelo, talla, sum(cantidad)::integer AS q
                  FROM lineas_pedido WHERE id_pedido = NEW.id_pedido
                 GROUP BY id_modelo, talla) x
         WHERE s.id_modelo = x.id_modelo AND s.talla = x.talla;
    END IF;
    RETURN NULL;
END ]]></definition>
</function>

<trigger name="t3_pedidos_stock" firing-type="AFTER" per-line="true" constraint="false"
	 ins-event="false" del-event="false" upd-event="true" trunc-event="false"
	 table="public.pedidos">
	<condition><![CDATA[(old.estado IS DISTINCT FROM new.estado)]]></condition>
		<function signature="public.fn_pedidos_stock()"/>
</trigger>

<function name="fn_auditar"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[DECLARE
    v_reg   jsonb := to_jsonb(CASE WHEN TG_OP = 'DELETE' THEN OLD ELSE NEW END);
    v_res   text;
BEGIN
    IF TG_OP = 'INSERT' THEN
        v_res := 'alta ' || v_reg::text;
    ELSIF TG_OP = 'DELETE' THEN
        v_res := 'baja ' || v_reg::text;
    ELSE
        SELECT string_agg(o.key || ': ' || coalesce(o.value,'NULL') || ' -> ' || coalesce(n.value,'NULL'),
                          '; ' ORDER BY o.key)
          INTO v_res
          FROM jsonb_each_text(to_jsonb(OLD)) AS o(key, value)
          JOIN jsonb_each_text(to_jsonb(NEW)) AS n(key, value) ON n.key = o.key
         WHERE o.value IS DISTINCT FROM n.value;
    END IF;

    INSERT INTO log_eventos (tabla, operacion, id_registro, id_usuario, resumen)
    VALUES (TG_TABLE_NAME, TG_OP, v_reg ->> TG_ARGV[0], fn_usuario_actual(), v_res);
    RETURN NULL;
END ]]></definition>
</function>

<trigger name="t4_pedidos_audit_altabaja" firing-type="AFTER" per-line="true" constraint="false"
	 ins-event="true" del-event="true" upd-event="false" trunc-event="false" arguments="id_pedido"
	 table="public.pedidos">
		<function signature="public.fn_auditar()"/>
</trigger>

<trigger name="t4_pedidos_audit_cambios" firing-type="AFTER" per-line="true" constraint="false"
	 ins-event="false" del-event="false" upd-event="true" trunc-event="false" arguments="id_pedido"
	 table="public.pedidos">
	<condition><![CDATA[((old.estado IS DISTINCT FROM new.estado) OR (old.id_cliente IS DISTINCT FROM new.id_cliente) OR (old.fecha IS DISTINCT FROM new.fecha))]]></condition>
		<function signature="public.fn_auditar()"/>
</trigger>

<function name="fn_lineas_antes"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[DECLARE
    v_estado text;
    v_base   numeric(8,2);
BEGIN
    PERFORM fn_exigir_permiso('editar_pedido');

    SELECT estado INTO v_estado FROM pedidos
     WHERE id_pedido = CASE WHEN TG_OP = 'DELETE' THEN OLD.id_pedido ELSE NEW.id_pedido END;
    IF v_estado IS DISTINCT FROM 'pendiente' THEN
        RAISE EXCEPTION 'No se pueden modificar líneas: el pedido no existe o está % ', v_estado;
    END IF;

    IF TG_OP = 'DELETE' THEN
        RETURN OLD;
    END IF;

    IF TG_OP = 'UPDATE' AND NEW.id_pedido <> OLD.id_pedido THEN
        RAISE EXCEPTION 'Una línea no se puede mover a otro pedido';
    END IF;

    NEW.texto_suela := nullif(btrim(NEW.texto_suela), '');

    -- Precio automático: base del modelo + 15 € si es personalizada + 5 € si lleva texto
    IF NEW.precio_unitario IS NULL THEN
        SELECT precio_base INTO v_base FROM modelos WHERE id_modelo = NEW.id_modelo;
        IF NOT FOUND THEN
            RAISE EXCEPTION 'El modelo % no existe en el catálogo', NEW.id_modelo
                  USING ERRCODE = '23503';
        END IF;
        NEW.precio_unitario := v_base
            + CASE WHEN NEW.color_cuerpo IS NOT NULL THEN 15 ELSE 0 END
            + CASE WHEN NEW.texto_suela  IS NOT NULL THEN 5  ELSE 0 END;
    END IF;
    RETURN NEW;
END ]]></definition>
</function>

<trigger name="t1_lineas_antes" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="true" upd-event="true" trunc-event="false"
	 table="public.lineas_pedido">
		<function signature="public.fn_lineas_antes()"/>
</trigger>

<function name="fn_lineas_total"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[DECLARE
    v_id integer := CASE WHEN TG_OP = 'DELETE' THEN OLD.id_pedido ELSE NEW.id_pedido END;
BEGIN
    UPDATE pedidos p
       SET total = coalesce((SELECT sum(l.cantidad * l.precio_unitario)
                               FROM lineas_pedido l WHERE l.id_pedido = p.id_pedido), 0),
           tipo  = CASE WHEN EXISTS (SELECT 1 FROM lineas_pedido l
                                      WHERE l.id_pedido = p.id_pedido
                                        AND l.color_cuerpo IS NOT NULL)
                        THEN 'custom' ELSE 'estandar' END
     WHERE p.id_pedido = v_id;
    RETURN NULL;
END ]]></definition>
</function>

<trigger name="t2_lineas_total" firing-type="AFTER" per-line="true" constraint="false"
	 ins-event="true" del-event="true" upd-event="true" trunc-event="false"

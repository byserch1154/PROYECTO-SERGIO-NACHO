	<schema name="public"/>
	<comment><![CDATA[cryptographic functions]]></comment>
</extension>

<domain name="talla_t" not-null="false">
	<schema name="public"/>
	<role name="postgres"/>
	<type name="smallint" length="2" precision="0"/>
	<constraint name="talla_t_check" type="check">
		<expression><![CDATA[((VALUE >= 38) AND (VALUE <= 46))]]></expression>
	</constraint>
</domain>

<domain name="color_t" not-null="false">
	<schema name="public"/>
	<role name="postgres"/>
	<type name="text" length="1"/>
	<constraint name="color_t_check" type="check">
		<expression><![CDATA[(VALUE = ANY (ARRAY['Negro'::text, 'Blanco'::text, 'Azul eléctrico'::text, 'Rojo'::text, 'Verde'::text, 'Amarillo'::text, 'Naranja'::text, 'Gris'::text]))]]></expression>
	</constraint>
</domain>


	</column>
	<column name="id_pedido" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="id_modelo" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="talla" not-null="true">
		<type name="public.talla_t" length="0"/>
	</column>
	<column name="cantidad" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="precio_unitario" not-null="true">
		<type name="numeric" length="8" precision="2"/>
	</column>
	<column name="color_cuerpo">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_franja">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_puntera">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_talon">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_suela">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_cordones">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="texto_suela">
		<type name="character varying" length="12"/>
	</column>
	<column name="id_color">
		<type name="smallint" length="0"/>
	</column>
	<constraint name="lineas_pedido_cantidad_check" type="ck-constr" table="public.lineas_pedido">
			<expression><![CDATA[(cantidad > 0)]]></expression>
	</constraint>
	<constraint name="lineas_pedido_precio_unitario_check" type="ck-constr" table="public.lineas_pedido">
			<expression><![CDATA[(precio_unitario >= (0)::numeric)]]></expression>
	</constraint>
	<constraint name="ck_personalizacion_completa" type="ck-constr" table="public.lineas_pedido">
			<expression><![CDATA[(num_nonnulls(color_cuerpo, color_franja, color_puntera, color_talon, color_suela, color_cordones) = ANY (ARRAY[0, 6]))]]></expression>
	</constraint>
	<constraint name="ck_texto_solo_custom" type="ck-constr" table="public.lineas_pedido">
			<expression><![CDATA[((texto_suela IS NULL) OR (color_cuerpo IS NOT NULL))]]></expression>
	</constraint>
	<constraint name="lineas_pedido_pkey" type="pk-constr" table="public.lineas_pedido">
		<columns names="id_linea" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_color_catalogo_estandar" type="ck-constr" table="public.lineas_pedido">
			<expression><![CDATA[((id_color IS NULL) OR (color_cuerpo IS NULL))]]></expression>
	</constraint>
</table>


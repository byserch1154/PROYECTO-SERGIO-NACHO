<function name="fn_buscar_pedidos"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="referencia">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="fecha">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="cliente">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="estado">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="tipo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="pares">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="total">
		<type name="numeric" length="0"/>
	</parameter>
	</return-type>
	<parameter name="p_cliente" in="true" default-value="NULL::text">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_modelo" in="true" default-value="NULL::text">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_estado" in="true" default-value="NULL::text">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_desde" in="true" default-value="NULL::date">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="p_hasta" in="true" default-value="NULL::date">
		<type name="date" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_pedidos');
    RETURN QUERY
    SELECT p.referencia, p.fecha, c.nombre, p.estado, p.tipo,
           coalesce((SELECT sum(l.cantidad) FROM lineas_pedido l
                      WHERE l.id_pedido = p.id_pedido), 0)::integer,
           p.total
      FROM pedidos p JOIN clientes c USING (id_cliente)
     WHERE (p_cliente IS NULL OR c.nombre ILIKE '%' || p_cliente || '%')
       AND (p_estado  IS NULL OR p.estado = p_estado)
       AND (p_desde   IS NULL OR p.fecha >= p_desde)
       AND (p_hasta   IS NULL OR p.fecha <= p_hasta)
       AND (p_modelo  IS NULL OR EXISTS (
              SELECT 1 FROM lineas_pedido l JOIN modelos m USING (id_modelo)
               WHERE l.id_pedido = p.id_pedido AND m.codigo = p_modelo))
     ORDER BY p.fecha DESC, p.id_pedido DESC;
END ]]></definition>
</function>

<function name="fn_stock_bajo"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="modelo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="talla">
		<type name="smallint" length="0"/>
	</parameter>
	<parameter name="stock_disponible">
		<type name="integer" length="0"/>
	</parameter>
	</return-type>
	<parameter name="p_umbral" in="true" default-value="5">
		<type name="integer" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_stock');
    RETURN QUERY
    SELECT m.nombre, s.talla::smallint, s.stock_disponible
      FROM stock s JOIN modelos m USING (id_modelo)
     WHERE s.stock_disponible <= p_umbral
     ORDER BY s.stock_disponible, m.nombre, s.talla;
END ]]></definition>
</function>

<function name="fn_indicadores"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="indicador">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="valor">
		<type name="numeric" length="0"/>
	</parameter>
	</return-type>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_pedidos');
    RETURN QUERY
    SELECT 'pedidos_totales', count(*)::numeric FROM pedidos
    UNION ALL
    -- pares solicitados = pares de pedidos no cancelados (actividad)
    SELECT 'pares_solicitados', coalesce(sum(l.cantidad),0)::numeric
      FROM lineas_pedido l JOIN pedidos p USING (id_pedido)
     WHERE p.estado <> 'cancelado'
    UNION ALL
    -- pares vendidos = pares de pedidos confirmados o entregados (ventas)
    SELECT 'pares_vendidos', coalesce(sum(l.cantidad),0)::numeric
      FROM lineas_pedido l JOIN pedidos p USING (id_pedido)
     WHERE p.estado IN ('confirmado','entregado')
    UNION ALL
    SELECT 'importe_ventas', coalesce(sum(total),0)
      FROM pedidos WHERE estado IN ('confirmado','entregado')
    UNION ALL
    SELECT 'pedidos_' || e.estado, count(p.id_pedido)::numeric
      FROM (VALUES ('pendiente'),('confirmado'),('entregado'),('cancelado')) e(estado)
      LEFT JOIN pedidos p ON p.estado = e.estado
     GROUP BY e.estado;
END ]]></definition>
</function>


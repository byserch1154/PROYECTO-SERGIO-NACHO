<function name="fn_crear_usuario"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="integer" length="0"/>
	</return-type>
	<parameter name="p_username">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_password">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_rol">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[DECLARE v_id integer;
BEGIN
    PERFORM fn_exigir_permiso('gestionar_usuarios');
    INSERT INTO usuarios (username, password_hash, id_rol)
    SELECT p_username, crypt(p_password, gen_salt('bf', 10)), r.id_rol
      FROM roles r WHERE r.nombre = p_rol
    RETURNING id_usuario INTO v_id;
    IF v_id IS NULL THEN
        RAISE EXCEPTION 'El rol "%" no existe', p_rol;
    END IF;
    RETURN v_id;
END ]]></definition>
</function>

<function name="fn_cambiar_activo"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="void" length="0"/>
	</return-type>
	<parameter name="p_id">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="p_activo">
		<type name="boolean" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('gestionar_usuarios');
    IF NOT p_activo AND p_id = fn_usuario_actual() THEN
        RAISE EXCEPTION 'No puedes desactivar tu propio usuario';
    END IF;
    UPDATE usuarios SET activo = p_activo WHERE id_usuario = p_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Usuario % inexistente', p_id; END IF;
END ]]></definition>
</function>

<function name="fn_cambiar_rol"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="void" length="0"/>
	</return-type>
	<parameter name="p_id">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="p_rol">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('gestionar_usuarios');
    UPDATE usuarios SET id_rol = (SELECT id_rol FROM roles WHERE nombre = p_rol)
     WHERE id_usuario = p_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Usuario % o rol "%" inexistente', p_id, p_rol; END IF;
END ]]></definition>
</function>

<function name="fn_listar_usuarios"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="id_usuario">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="username">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="rol">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="activo">
		<type name="boolean" length="0"/>
	</parameter>
	<parameter name="fecha_creacion">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</parameter>
	</return-type>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('exportar_usuarios');
    RETURN QUERY
    SELECT u.id_usuario, u.username, r.nombre, u.activo, u.fecha_creacion
      FROM usuarios u JOIN roles r USING (id_rol) ORDER BY u.id_usuario;
END ]]></definition>
</function>

<function name="fn_auditoria"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="id_evento">
		<type name="bigint" length="0"/>
	</parameter>
	<parameter name="fecha">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</parameter>
	<parameter name="tabla">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="operacion">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="id_registro">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="usuario">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="resumen">
		<type name="text" length="0"/>
	</parameter>
	</return-type>
	<parameter name="p_limite" in="true" default-value="100">
		<type name="integer" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('ver_auditoria');
    RETURN QUERY
    SELECT e.id_evento, e.fecha, e.tabla, e.operacion, e.id_registro, u.username, e.resumen
      FROM log_eventos e JOIN usuarios u USING (id_usuario)
     ORDER BY e.id_evento DESC LIMIT p_limite;
END ]]></definition>
</function>

<function name="fn_cliente_web"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="integer" length="0"/>
	</return-type>
	<parameter name="p_nombre">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_email">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_telefono">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_tipo">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[DECLARE v_id integer;
BEGIN
    PERFORM fn_exigir_permiso('crear_pedido');
    INSERT INTO clientes (nombre, email, telefono, tipo)
    VALUES (btrim(p_nombre), lower(btrim(p_email)), nullif(btrim(p_telefono), ''),
            coalesce(p_tipo, 'particular'))
    ON CONFLICT (email) DO UPDATE
       SET nombre = EXCLUDED.nombre,
           telefono = coalesce(EXCLUDED.telefono, clientes.telefono)
    RETURNING id_cliente INTO v_id;
    RETURN v_id;
END ]]></definition>
</function>

<function name="fn_detalle_pedido"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="referencia">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="fecha">
		<type name="date" length="0"/>
	</parameter>
	<parameter name="cliente">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="estado">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="tipo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="total">
		<type name="numeric" length="0"/>
	</parameter>
	<parameter name="id_linea">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="modelo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="talla">
		<type name="smallint" length="0"/>
	</parameter>
	<parameter name="cantidad">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="precio_unitario">
		<type name="numeric" length="0"/>
	</parameter>
	<parameter name="personalizacion">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="texto_suela">
		<type name="text" length="0"/>
	</parameter>
	</return-type>
	<parameter name="p_referencia" in="true">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_pedidos');
    RETURN QUERY
    SELECT p.referencia, p.fecha, c.nombre, p.estado, p.tipo, p.total,
           l.id_linea, m.nombre, l.talla::smallint, l.cantidad, l.precio_unitario,
           CASE WHEN l.color_cuerpo IS NOT NULL THEN
                concat_ws(' / ', l.color_cuerpo, l.color_franja, l.color_puntera,
                          l.color_talon, l.color_suela, l.color_cordones)
                WHEN cc.nombre IS NOT NULL THEN 'Color de catálogo: ' || cc.nombre
           END,
           l.texto_suela::text
      FROM pedidos p
      JOIN clientes c USING (id_cliente)
      LEFT JOIN lineas_pedido l ON l.id_pedido = p.id_pedido
      LEFT JOIN modelos m ON m.id_modelo = l.id_modelo
      LEFT JOIN colores_catalogo cc ON cc.id_color = l.id_color
     WHERE p.referencia = p_referencia
     ORDER BY l.talla, l.id_linea;
END ]]></definition>
</function>

<function name="fn_analisis_modelos"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="modelo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="pedidos">
		<type name="bigint" length="0"/>
	</parameter>
	<parameter name="pares">
		<type name="bigint" length="0"/>
	</parameter>
	<parameter name="importe">
		<type name="numeric" length="0"/>
	</parameter>
	</return-type>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_pedidos');
    RETURN QUERY
    SELECT m.nombre,
           count(DISTINCT p.id_pedido),                       -- pedidos, no líneas
           coalesce(sum(l.cantidad) FILTER (WHERE p.id_pedido IS NOT NULL), 0)::bigint,
           coalesce(sum(l.cantidad * l.precio_unitario) FILTER (WHERE p.id_pedido IS NOT NULL), 0)
      FROM modelos m
      LEFT JOIN lineas_pedido l ON l.id_modelo = m.id_modelo
      LEFT JOIN pedidos p ON p.id_pedido = l.id_pedido AND p.estado IN ('confirmado','entregado')
     GROUP BY m.nombre
     ORDER BY 3 DESC, 1;
END ]]></definition>
</function>

<function name="fn_analisis_tallas"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="talla">
		<type name="smallint" length="0"/>
	</parameter>
	<parameter name="pares">
		<type name="bigint" length="0"/>
	</parameter>
	</return-type>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('consultar_pedidos');
    RETURN QUERY
    SELECT t::smallint, coalesce(sum(l.cantidad) FILTER (WHERE p.id_pedido IS NOT NULL), 0)::bigint
      FROM generate_series(38, 46) t
      LEFT JOIN lineas_pedido l ON l.talla = t
      LEFT JOIN pedidos p ON p.id_pedido = l.id_pedido AND p.estado IN ('confirmado','entregado')
     GROUP BY t ORDER BY t;
END ]]></definition>
</function>

<view name="v_reconciliacion" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1280" y="1540"/>
	<reference>
		<expression><![CDATA[ SELECT 'pedidos_totales'::text AS indicador,
    (count(*))::numeric AS valor
   FROM pedidos
UNION ALL
 SELECT 'lineas_totales'::text AS indicador,
    (count(*))::numeric AS valor
   FROM lineas_pedido
UNION ALL
 SELECT 'pedidos_venta'::text AS indicador,
    (count(*))::numeric AS valor
   FROM pedidos
  WHERE (pedidos.estado = ANY (ARRAY['confirmado'::text, 'entregado'::text]))
UNION ALL
 SELECT 'pares_vendidos'::text AS indicador,
    (COALESCE(sum(l.cantidad), (0)::bigint))::numeric AS valor
   FROM (lineas_pedido l
     JOIN pedidos p USING (id_pedido))
  WHERE (p.estado = ANY (ARRAY['confirmado'::text, 'entregado'::text]))
UNION ALL
 SELECT 'importe_ventas'::text AS indicador,
    COALESCE(sum(pedidos.total), (0)::numeric) AS valor
   FROM pedidos
  WHERE (pedidos.estado = ANY (ARRAY['confirmado'::text, 'entregado'::text]))
UNION ALL
 SELECT 'clientes_con_venta'::text AS indicador,
    (count(DISTINCT pedidos.id_cliente))::numeric AS valor
   FROM pedidos
  WHERE (pedidos.estado = ANY (ARRAY['confirmado'::text, 'entregado'::text]));]]></expression>
	<column name="indicador">
		<type name="text" length="0"/>
	</column>
	<column name="valor">
		<type name="numeric" length="0"/>
	</column>
		<reftable name="public.pedidos"/>
		<reftable name="public.lineas_pedido"/>
	</reference>
</view>


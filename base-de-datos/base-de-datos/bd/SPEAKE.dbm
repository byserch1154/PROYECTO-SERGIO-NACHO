	 src-required="false" dst-required="false"/>

<table name="pedidos_odoo" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="2260" y="500"/>
	<column name="id_pedido" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="pedido_odoo">
		<type name="text" length="0"/>
	</column>
	<column name="id_odoo">
		<type name="integer" length="0"/>
	</column>
	<column name="estado" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="mensaje">
		<type name="text" length="0"/>
	</column>
	<column name="actualizado" not-null="true" default-value="now()">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
	<constraint name="pedidos_odoo_estado_check" type="ck-constr" table="public.pedidos_odoo">
			<expression><![CDATA[(estado = ANY (ARRAY['enviado'::text, 'error'::text]))]]></expression>
	</constraint>
	<constraint name="pedidos_odoo_pkey" type="pk-constr" table="public.pedidos_odoo">
		<columns names="id_pedido" ref-type="src-columns"/>
	</constraint>
</table>

<function name="fn_registrar_envio_odoo"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="void" length="0"/>
	</return-type>
	<parameter name="p_referencia">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_estado">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_pedido_odoo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="p_id_odoo">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="p_mensaje">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[BEGIN
    PERFORM fn_exigir_permiso('confirmar_pedido');
    INSERT INTO pedidos_odoo (id_pedido, pedido_odoo, id_odoo, estado, mensaje)
    SELECT id_pedido, p_pedido_odoo, p_id_odoo, p_estado, left(p_mensaje, 300)
      FROM pedidos WHERE referencia = p_referencia
    ON CONFLICT (id_pedido) DO UPDATE
       SET pedido_odoo = coalesce(EXCLUDED.pedido_odoo, pedidos_odoo.pedido_odoo),
           id_odoo     = coalesce(EXCLUDED.id_odoo, pedidos_odoo.id_odoo),
           estado      = EXCLUDED.estado,
           mensaje     = EXCLUDED.mensaje,
           actualizado = now();
END ]]></definition>
</function>

<view name="v_pedidos_odoo" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="2280" y="1380"/>
	<reference>
		<expression><![CDATA[ SELECT p.referencia,
    o.pedido_odoo,
    o.estado,
    o.mensaje,
    o.actualizado
   FROM (pedidos_odoo o
     JOIN pedidos p USING (id_pedido));]]></expression>
	<column name="referencia">
		<type name="text" length="0"/>
	</column>
	<column name="pedido_odoo">
		<type name="text" length="0"/>
	</column>
	<column name="estado">
		<type name="text" length="0"/>
	</column>
	<column name="mensaje">
		<type name="text" length="0"/>
	</column>
	<column name="actualizado">
		<type name="timestamp with time zone" length="0" with-timezone="true"/>
	</column>
		<reftable name="public.pedidos"/>
		<reftable name="public.pedidos_odoo"/>
	</reference>
</view>


<view name="v_ficha_fabricacion" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="940" y="1540"/>
	<reference>
		<expression><![CDATA[ SELECT p.referencia,
    c.nombre AS cliente,
    m.nombre AS modelo,
    l.color_cuerpo,
    l.color_franja,
    l.color_puntera,
    l.color_talon,
    l.color_suela,
    l.color_cordones,
    l.texto_suela,
    l.talla,
    l.cantidad
   FROM (((lineas_pedido l
     JOIN pedidos p USING (id_pedido))
     JOIN clientes c USING (id_cliente))
     JOIN modelos m USING (id_modelo))
  WHERE ((p.estado = 'confirmado'::text) AND (l.color_cuerpo IS NOT NULL))
  ORDER BY p.referencia, l.talla;]]></expression>
	<column name="referencia">
		<type name="text" length="0"/>
	</column>
	<column name="cliente">
		<type name="text" length="0"/>
	</column>
	<column name="modelo">
		<type name="text" length="0"/>
	</column>
	<column name="color_cuerpo">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_franja">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_puntera">

	<constraint name="pedidos_tipo_check" type="ck-constr" table="public.pedidos">
			<expression><![CDATA[(tipo = ANY (ARRAY['estandar'::text, 'custom'::text]))]]></expression>
	</constraint>
	<constraint name="pedidos_total_check" type="ck-constr" table="public.pedidos">
			<expression><![CDATA[(total >= (0)::numeric)]]></expression>
	</constraint>

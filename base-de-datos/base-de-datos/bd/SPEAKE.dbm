<table name="colores_catalogo" layers="0" collapse-mode="2" max-obj-count="15" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="660" y="1140"/>
	<column name="id_color" not-null="true" sequence="public.colores_catalogo_id_color_seq">
		<type name="smallint" length="0"/>
	</column>
	<column name="id_modelo" not-null="true">
		<type name="smallint" length="0"/>
	</column>
	<column name="codigo" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="orden" not-null="true" default-value="1">
		<type name="smallint" length="0"/>
	</column>
	<column name="color_cuerpo" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_franja" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_puntera" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_talon" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_suela" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_cordones" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="color_detalle" not-null="true">
		<type name="public.color_t" length="0"/>
	</column>
	<column name="activo" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="colores_catalogo_pkey" type="pk-constr" table="public.colores_catalogo">
		<columns names="id_color" ref-type="src-columns"/>
	</constraint>
	<constraint name="colores_catalogo_codigo_key" type="uq-constr" table="public.colores_catalogo">
		<columns names="codigo" ref-type="src-columns"/>
	</constraint>
</table>

<function name="fn_lineas_color_catalogo"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition><![CDATA[BEGIN
    IF NEW.id_color IS NOT NULL AND NOT EXISTS (
        SELECT 1 FROM colores_catalogo c
         WHERE c.id_color = NEW.id_color AND c.id_modelo = NEW.id_modelo) THEN
        RAISE EXCEPTION 'Ese color de catálogo no corresponde al modelo de la línea';
    END IF;
    RETURN NEW;
END ]]></definition>
</function>

<trigger name="t1b_lineas_color" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="true" del-event="false" upd-event="true" trunc-event="false"
	 table="public.lineas_pedido">
		<function signature="public.fn_lineas_color_catalogo()"/>
</trigger>

<index name="ux_linea_pedido" table="public.lineas_pedido"
	 concurrent="false" unique="true" fast-update="false" buffering="false"
	 index-type="btree" factor="90">
		<idxelement use-sorting="false">
			<column name="id_pedido"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="id_modelo"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="talla"/>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((id_color)::integer, 0)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_cuerpo)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_franja)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_puntera)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_talon)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_suela)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE((color_cordones)::text, ''::text)]]></expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression><![CDATA[COALESCE(texto_suela, ''::character varying)]]></expression>
		</idxelement>
</index>

<function name="fn_pedido_para_odoo"
		window-func="false"
		returns-setof="true"
		behavior-type="CALLED ON NULL INPUT"
		function-type="STABLE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="1000">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<parameter name="referencia">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="estado">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="tipo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="cliente">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="email">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="telefono">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="tipo_cliente">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="modelo">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="talla">
		<type name="smallint" length="0"/>
	</parameter>
	<parameter name="cantidad">
		<type name="integer" length="0"/>
	</parameter>
	<parameter name="precio_unitario">
		<type name="numeric" length="0"/>
	</parameter>
	<parameter name="personalizacion">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="texto_suela">
		<type name="text" length="0"/>
	</parameter>
	<parameter name="color_catalogo">
		<type name="text" length="0"/>
	</parameter>
	</return-type>
	<parameter name="p_referencia" in="true">
		<type name="text" length="0"/>
	</parameter>
	<definition><![CDATA[DECLARE v_estado text;
BEGIN
    PERFORM fn_exigir_permiso('confirmar_pedido');

    SELECT p.estado INTO v_estado FROM pedidos p WHERE p.referencia = p_referencia;
    IF v_estado IS NULL THEN
        RAISE EXCEPTION 'No existe el pedido %', p_referencia;
    END IF;
    IF v_estado NOT IN ('confirmado', 'entregado') THEN
        RAISE EXCEPTION 'El pedido % está %: solo se envían a Odoo los pedidos confirmados',
                        p_referencia, v_estado;
    END IF;

    RETURN QUERY
    SELECT p.referencia, p.estado, p.tipo,
           c.nombre, c.email, c.telefono, c.tipo,
           m.nombre, l.talla::smallint, l.cantidad, l.precio_unitario,
           CASE WHEN l.color_cuerpo IS NULL THEN NULL ELSE
                concat_ws(' / ', l.color_cuerpo, l.color_franja, l.color_puntera,
                          l.color_talon, l.color_suela, l.color_cordones) END,
           l.texto_suela::text,
           cc.nombre
      FROM pedidos p
      JOIN clientes c USING (id_cliente)
      JOIN lineas_pedido l ON l.id_pedido = p.id_pedido
      JOIN modelos m ON m.id_modelo = l.id_modelo
      LEFT JOIN colores_catalogo cc ON cc.id_color = l.id_color
     WHERE p.referencia = p_referencia
     ORDER BY l.talla, l.id_linea;
END ]]></definition>
</function>

